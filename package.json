{
  "name": "hollowkit-microservices",
  "version": "1.0.0",
  "description": "Monorepo for NestJS microservices with gRPC communication",
  "private": true,
  "scripts": {
    "build": "yarn workspaces foreach --topological-dev run build",
    "start": "yarn workspaces foreach --topological-dev run start",
    "start:dev": "yarn workspaces foreach --parallel run start:dev",
    "start:gateway": "cd apps/api-gateway && bun --watch src/main.ts",
    "start:user-service": "cd apps/user-service && bun --watch src/main.ts",
    "test": "yarn workspaces foreach run test",
    "test:e2e": "yarn workspaces foreach run test:e2e",
    "lint": "yarn workspaces foreach run lint",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "proto:gen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/types/src --ts_proto_opt=nestjs=true,esModuleInterop=true,env=node,forceLong=number,useOptionals=messages --proto_path=libs/proto libs/proto/*.proto",
    "proto:compile": "node scripts/compile-proto.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:all": "yarn install && yarn workspaces foreach install"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@grpc/proto-loader": "^0.7.15",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "protoc-gen-ts": "^0.8.7",
    "ts-node": "^10.0.0",
    "ts-proto": "^2.7.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
